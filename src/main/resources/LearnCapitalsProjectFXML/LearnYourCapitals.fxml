<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <!-- TOP: Tittel -->
    <BorderPane>
        <top>
            <Label alignment="CENTER" contentDisplay="CENTER"
                   prefHeight="75.0" prefWidth="458.0"
                   style="-fx-font-size: 24px; -fx-padding: 20;"
                   text="Learn Your Capitals" textAlignment="CENTER"
                   textFill="#25bad8" underline="true">
                <font><Font name="System Bold" size="1.0" /></font>
            </Label>
        </top>

        <!-- CENTER: Liste med kontinenter -->
        <center>
            <VBox alignment="CENTER" prefHeight="361.0" prefWidth="458.0" spacing="10">
                <padding><Insets top="20" /></padding>

                <Label text="Choose one:">
                    <font><Font size="16.0" /></font>
                </Label>

                <Button onAction="#handleContinentClick" text="Asia">
                    <font><Font size="14.0" /></font>
                </Button>
                <Button onAction="#handleContinentClick" text="Africa">
                    <font><Font size="14.0" /></font>
                </Button>
                <Button onAction="#handleContinentClick" text="North America">
                    <font><Font size="14.0" /></font>
                </Button>
                <Button onAction="#handleContinentClick" text="South America">
                    <font><Font size="14.0" /></font>
                </Button>
                <Button onAction="#handleContinentClick" text="Europe">
                    <font><Font size="14.0" /></font>
                </Button>
                <Button onAction="#handleContinentClick" text="Oceania">
                    <font><Font size="14.0" /></font>
                </Button>
            </VBox>
        </center>
    </BorderPane>

    <!--OVERLAY 1: Velg kontinent-meny (Choice / New Game / Leaderboard) -->
    <StackPane fx:id="overlayChosenContinent"
               style="-fx-background-color: rgba(0,0,0,0.3);" managed="false" visible="false">

        <StackPane.margin><Insets top="75"/></StackPane.margin>

        <VBox alignment="CENTER" maxWidth="300" spacing="15"
              style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 10;">

            <!-- Valgt kontinent som overskrift -->
            <Label fx:id="overlayContinentLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="" textFill="#fd7419" />

            <!-- VIEW 1: overlayChoiceView -->
            <VBox fx:id="overlayChoiceView" alignment="CENTER"
                  prefHeight="242.0" prefWidth="246.0" spacing="15">
                <Label style="-fx-font-size: 12px;" text="Choose one:" />
                <Button onAction="#handleNewGame" text="New Game" />
                <Button onAction="#handleLeaderboard" text="Leaderboard" />
            </VBox>

            <!-- VIEW 2: overlayUserNameView -->
            <VBox fx:id="overlayUsernameView" alignment="CENTER"
                  managed="false" spacing="15" visible="false">
                <Label style="-fx-font-size: 12px;" text="Enter username:" />
                <TextField fx:id="userNameField" promptText="name...." />
                <Label fx:id="usernameErrorLabel"
                       style="-fx-font-size: 11px; -fx-text-fill: red;"
                       text="" visible="false" managed="false"/> 
                <HBox alignment="CENTER" spacing="10">
                    <Button onAction="#handleStartGame" text="Start game!" />
                    <Button onAction="#handleGoBack" text="Go Back" />
                </HBox>
            </VBox>

            <!-- VIEW 3: Leaderboard -->
            <VBox fx:id="overlayLeaderboardView" alignment="CENTER"
                  managed="false" spacing="15" visible="false">
                <Label style="-fx-font-size: 12px; -fx-font-weight: bold;" text="Leaderboard:" />
                <ListView fx:id="leaderboardList" prefHeight="150" prefWidth="200" />
                <Button onAction="#handleGoBack" text="Go Back" />
            </VBox>

            <Button onAction="#handleCloseOverlay" text="Back to continents" />
        </VBox>
    </StackPane>

    <!-- OVERLAY 2: SELVE SPILLET -->
    <StackPane fx:id="overlayGameView"
               style="-fx-background-color: rgba(0,0,0,0.5);"
               managed="false" visible="false">
        <StackPane.margin><Insets top="75"/></StackPane.margin>

        <VBox alignment="CENTER" maxWidth="380" spacing="14"
              style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 10;">

            <!-- Fremdrift: "Country 3 of 44" -->
            <Label fx:id="progressLabel"
                   style="-fx-font-size: 12px; -fx-text-fill: #888888;"
                   text="Country 1 of 44" />

            <!-- Spørsmål: "What is the capital of Norway?" -->
            <Label fx:id="countryLabel"
                   alignment="CENTER"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333333;"
                   text="What is the capital of ...?"
                   wrapText="true" />

            <!-- Bokstavbokser: genereres dynamisk fra controller -->
            <HBox fx:id="letterBoxContainer"
                  alignment="CENTER" spacing="5">
                <padding><Insets top="5" bottom="5" /></padding>
                <!-- TextField-ene legges inn her programmatisk via buildLetterBoxes() -->
            </HBox>

            <!-- Tilbakemelding: "Correct!" / "Wrong!" / feilmeldinger -->
            <Label fx:id="feedbackLabel"
                   alignment="CENTER"
                   style="-fx-font-size: 13px; -fx-font-weight: bold;"
                   text=""
                   wrapText="true" />

            <!-- Gjett-teller -->
            <Label fx:id="guessCountLabel"
                   style="-fx-font-size: 12px; -fx-text-fill: #555555;"
                   text="Guesses: 0" />

            <!-- Knapper: Guess og Hint -->
            <HBox alignment="CENTER" spacing="15">
                <padding><Insets top="5"/></padding>

                <Button onAction="#handleGuess"
                        text="Guess"
                        style="-fx-background-color: #25bad8; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-padding: 8 20;
                               -fx-background-radius: 6;" />

                <Button onAction="#handleHint"
                        text="Get hint (+2 guesses)"
                        style="-fx-background-color: #fd7419; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-padding: 8 20;
                               -fx-background-radius: 6;" />
            </HBox>

            <!-- Avslutt spillet -->
            <Button onAction="#handleQuitGame"
                    text="Quit game"
                    style="-fx-font-size: 11px; -fx-text-fill: #aaaaaa;
                           -fx-background-color: transparent;" />

        </VBox>
    </StackPane>

</StackPane>
